@page
@model IndexModel
@{
    Layout = "_Layout";
}

<div class="row">
    <!-- Form Column -->
    <div class="col">
        <h2>@(Model.EditId > 0 ? "EDIT CLASS" : "ADD CLASS")</h2>
        <form method="post">
            <input type="hidden" asp-for="ClassInfo.Id" />
            
            <div class="form-group">
                <label asp-for="ClassInfo.ClassName"></label>
                <input asp-for="ClassInfo.ClassName" class="form-control" />
                <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="ClassInfo.StudentCount"></label>
                <input asp-for="ClassInfo.StudentCount" class="form-control" />
                <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="ClassInfo.Description"></label>
                <textarea asp-for="ClassInfo.Description" class="form-control"></textarea>
                <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
            </div>
            
            <button type="submit" class="btn btn-primary" 
                    asp-page-handler="@(Model.EditId > 0 ? "Edit" : "Add")">
                @(Model.EditId > 0 ? "UPDATE" : "ADD")
            </button>
            
            @if (Model.EditId > 0)
            {
                <a asp-page="./Index" class="btn btn-secondary">CANCEL</a>
            }
        </form>
    </div>

    <!-- Table Column -->
    <div class="col">
        <h2>CLASS LIST</h2>
        
        <form method="get" class="filter-form">
            <div class="form-group">
                <input asp-for="FilterClassName" placeholder="Class name" class="form-control" />
            </div>
            <div class="form-group">
                <input asp-for="FilterStudentCount" placeholder="Student count" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">FILTER</button>
            <a asp-page="./Index" class="btn btn-secondary">RESET</a>
        </form>
        
        <table class="table">
            <thead>
                <tr>
                    <th>CLASS NAME</th>
                    <th>STUDENTS</th>
                    <th>DESCRIPTION</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.DisplayClasses)
                {
                    <tr>
                        <td>@item.ClassName</td>
                        <td>@item.StudentCount</td>
                        <td>@item.Description</td>
                        <td>
                            <a asp-page="./Index" 
                               asp-route-editId="@item.Id"
                               class="action-icon">✏️</a>
                            <form method="post" style="display:inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" asp-page-handler="Delete" 
                                        class="btn btn-link action-icon"
                                        onclick="return confirm('Delete this class?')">🗑️</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-page="./Index" 
                       asp-route-currentPage="@(Model.CurrentPage - 1)"
                       class="btn btn-primary">Previous</a>
                }
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-page="./Index" 
                       asp-route-currentPage="@i"
                       class="btn @(i == Model.CurrentPage ? "btn-primary" : "btn-secondary")">@i</a>
                }
                
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-page="./Index" 
                       asp-route-currentPage="@(Model.CurrentPage + 1)"
                       class="btn btn-primary">Next</a>
                }
            </div>
        }
    </div>
</div>

<partial name="_ValidationScriptsPartial" />