@page
@model IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container mt-4">
    <div class="row">
        <!-- Form Column -->
        <div class="col-md-6">
            <h2>@(Model.EditId > 0 ? "Edit Class" : "Add New Class")</h2>
            <form method="post" asp-page-handler="@(Model.EditId > 0 ? "Edit" : "Add")">
                @if (Model.EditId > 0)
                {
                    <input type="hidden" name="id" value="@Model.EditId" />
                }
                
                <div class="form-group">
                    <label asp-for="ClassInfo.ClassName">Class Name</label>
                    <input asp-for="ClassInfo.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="ClassInfo.StudentCount">Student Count</label>
                    <input asp-for="ClassInfo.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="ClassInfo.Description">Description</label>
                    <textarea asp-for="ClassInfo.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                </div>
                
                <button type="submit" class="btn btn-primary">
                    @(Model.EditId > 0 ? "Update" : "Add")
                </button>
                @if (Model.EditId > 0)
                {
                    <a href="/" class="btn btn-secondary">Cancel</a>
                }
            </form>
        </div>
        
        <!-- Table Column -->
        <div class="col-md-6">
            <h2>Class List</h2>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Students</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ClassList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <a asp-page="./Index" asp-route-editId="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <form method="post" asp-page-handler="Delete" style="display: inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}