@page
@model IndexModel

<div class="row">
    <!-- Form Column -->
    <div class="col">
        <h2>@(Model.EditId > 0 ? "EDIT CLASS" : "ADD CLASS")</h2>
        <form method="post">
            @if (Model.EditId > 0)
            {
                <input type="hidden" name="ClassInfo.Id" value="@Model.ClassInfo.Id" />
            }
            
            <div class="form-group">
                <label>Class Name:</label>
                <input type="text" name="ClassInfo.ClassName" value="@Model.ClassInfo.ClassName" />
                <span class="text-danger">@Html.ValidationMessage("ClassInfo.ClassName")</span>
            </div>
            
            <div class="form-group">
                <label>Student Count:</label>
                <input type="number" name="ClassInfo.StudentCount" value="@Model.ClassInfo.StudentCount" />
                <span class="text-danger">@Html.ValidationMessage("ClassInfo.StudentCount")</span>
            </div>
            
            <div class="form-group">
                <label>Description:</label>
                <textarea name="ClassInfo.Description">@Model.ClassInfo.Description</textarea>
                <span class="text-danger">@Html.ValidationMessage("ClassInfo.Description")</span>
            </div>
            
            <button type="submit" name="handler" value="@(Model.EditId > 0 ? "Edit" : "Add")">
                @(Model.EditId > 0 ? "UPDATE" : "ADD")
            </button>
            
            @if (Model.EditId > 0)
            {
                <a href="/" class="button">CANCEL</a>
            }
        </form>
    </div>

    <!-- Table Column -->
    <div class="col">
        <h2>CLASS LIST</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>CLASS NAME</th>
                    <th>STUDENTS</th>
                    <th>DESCRIPTION</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ClassList)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.ClassName</td>
                        <td>@item.StudentCount</td>
                        <td>@item.Description</td>
                        <td class="actions-cell">
                            <a href="/?editId=@item.Id" class="action-icon edit-icon" title="Edit">✏️</a>
                            <form method="post" style="display:inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="handler" value="Delete" />
                                <button type="submit" class="delete-btn" title="Delete">
                                    <span class="action-icon delete-icon">🗑️</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- I added emoji icons for delete and edit parts by asking deepseek can you add trash bin icon for delete and pen icon for edit  -->
